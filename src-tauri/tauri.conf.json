{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "MarsWin",
  "version": "1.0.0",
  "identifier": "com.marswin.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "MarsWin",
        "url": "index.html",
        "width": 407,
        "height": 513,
        "resizable": false,
        "maximizable": false,
        "decorations": false,
        "center": true,
        "visible": false,
        "backgroundColor": "#09090b"
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; font-src 'self' data:; img-src 'self' data:"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": { "languages": ["Ukrainian", "English"], "displayLanguageSelector": false }
    }
  }
}
